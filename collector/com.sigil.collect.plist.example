<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.sigil.collect</string>
<key>ProgramArguments</key><array>
<string>REPO_PATH/.venv/bin/python</string>
<string>REPO_PATH/collector/collect.py</string>
<string>--config</string><string>REPO_PATH/collector/config.json</string>
</array>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardOutPath</key><string>/tmp/sigil-collect.log</string>
<key>StandardErrorPath</key><string>/tmp/sigil-collect-error.log</string>
</dict></plist>
